# Live Upstox tick/L1 collector (1-second bars).  Install: sudo cp deploy/jarvis-feed.service /etc/systemd/system/
# then: sudo systemctl daemon-reload && sudo systemctl enable --now jarvis-feed
# The process sleeps until 03:40 UTC on each weekday, runs the session, compacts the day, and waits for the next one.
# UPSTOX_FEED_TOKEN should be the Analytics Token (1-year validity, confirmed working via `auth check`,
# section 13.2) so no daily refresh is needed. If it ever gets rejected (401/403 in the logs), renew it
# at the developer console, or fall back to the daily access-token login (runbook section 0.9); no
# restart needed either way, the collector re-reads .env and retries.
[Unit]
Description=JARVIS Upstox live feed collector
After=network-online.target
Wants=network-online.target
# an expired token no longer makes the process exit (it waits and retries), so this only guards real crash loops
StartLimitIntervalSec=600
StartLimitBurst=10

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/JARVIS
EnvironmentFile=/home/jarvis/JARVIS/.env
# Widened to the full NIFTY 500 universe (2026-10-30) after the 5-ticker Gate U1 smoke test came back
# clean. Real per-connection subscription limits are still unverified (runbook 13.3) -- watch the log
# for 401/403 or subscribe errors; fall back to --limit N if Upstox rejects the full batch.
ExecStart=/home/jarvis/JARVIS/.venv/bin/python -m data_layer.upstox.feed
# SIGTERM makes the collector save the bars received so far and compact the day before it exits
KillSignal=SIGTERM
TimeoutStopSec=60
Restart=always
RestartSec=15

[Install]
WantedBy=multi-user.target
