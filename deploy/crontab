# JARVIS cron jobs for the `jarvis` user.  Install:  crontab deploy/crontab      (server clock must be UTC)
# Times are UTC.  NSE session is 03:45-10:00; the equity live feed runs as the jarvis-feed service, not from
# cron.  The futures/options feed (below) runs once a day from cron instead, by design -- see section 17.
SHELL=/bin/bash
PATH=/home/jarvis/JARVIS/.venv/bin:/usr/local/bin:/usr/bin:/bin
JARVIS=/home/jarvis/JARVIS

# No daily Upstox token refresh job here: UPSTOX_FEED_TOKEN should be the Analytics Token (1-year
# validity, generated by hand once at the developer console, confirmed with `auth check`, section
# 13.2) rather than the daily OAuth login, which needs a human in a browser and can't be cron'd anyway.

# Daily OHLC for India, US, UK and EU, after the last close (NYSE closes 21:00 UTC in winter)
30 22 * * 1-5  cd $JARVIS && python scheduler.py --job ohlc-daily  >> logs/scheduler.log 2>&1
# Fundamentals rotation (India; spends the FMP free-tier budget on the stalest stocks)
0 12 * * 1-5   cd $JARVIS && python scheduler.py --job fundamentals >> logs/scheduler.log 2>&1
# Nightly backup snapshot: parked until a separate disk or bucket exists (SCRUM-121); health only warns, cron_check does not require it.
# When it is set up (JARVIS_BACKUP_DIR in .env), add:  30 23 * * *  cd $JARVIS && python -m data_layer.backup run >> logs/backup.log 2>&1
# Morning health report, before the session; mail or read logs/health.log
15 3 * * 1-5   cd $JARVIS && python -m data_layer.health >> logs/health.log 2>&1
# End-of-day health report, after the feed has compacted the day (10:05 UTC) and Yahoo's daily bar exists
30 11 * * 1-5  cd $JARVIS && python -m data_layer.health --after-close >> logs/health.log 2>&1

# Futures and options (NSE_FO; runbook section 17): refresh the instrument master and roll the tracked
# watchlist (data/fo_watchlist.csv: 1 future and 2 option expiries per index, all strikes) to today's nearest
# expiries before the session opens.  The feed refuses to start if the universe file is not from today or has fewer
# expiries than the watchlist asks for (--allow-stale-universe overrides it).
# What is stored comes from .env, read by both the equity service and this job (production, from 2026-11-03):
#   JARVIS_TICK_STORE=full  JARVIS_EXT_FIELDS=1  JARVIS_GREEKS=core  JARVIS_SYSMON=1
# core keeps IV, delta and gamma; theta, vega and rho are computed by the viewer (data_layer/greeks_calc.py).
# JARVIS_SYSMON=1 writes CPU, memory and disk samples to logs/resources-<segment>-<date>.jsonl.
25 3 * * 1-5   cd $JARVIS && python -m data_layer.upstox.fo_instruments import --download >> logs/fo-select.log 2>&1 && python -m data_layer.upstox.fo_instruments select --watchlist data/fo_watchlist.csv >> logs/fo-select.log 2>&1
# Run one full fo session (same 03:40 UTC start as the equity service). --once exits once that day's
# session closes and is compacted, so cron runs it fresh every weekday -- this is how the roll above
# takes effect, since a long-lived process would keep the contract list it started with (section 17.6).
40 3 * * 1-5   cd $JARVIS && python -m data_layer.upstox.feed --once --segment fo >> logs/fo-feed.log 2>&1

# Upstox company fundamentals (SCRUM-103).  Key ratios are today's value only, so a daily snapshot builds their history.
# Statements, shareholding, corporate actions, profile and peers: a weekly pass (Sunday 13:00 UTC, outside the feed window) that skips companies fetched in the last
# 20 days (about monthly; a full pass over 500 companies is roughly 90 minutes at the Upstox rate limit).
50 12 * * 1-5  cd $JARVIS && python -m data_layer.upstox.fundamentals run --set daily >> logs/fundamentals.log 2>&1
0 13 * * 0     cd $JARVIS && python -m data_layer.upstox.fundamentals run --set full --max-age-days 20 >> logs/fundamentals.log 2>&1
