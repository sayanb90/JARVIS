# Intraday viewer (read-only).  Add WEBAPP_USER and WEBAPP_PASSWORD to .env before exposing it.
# Install: sudo cp deploy/jarvis-viewer.service /etc/systemd/system/ && sudo systemctl enable --now jarvis-viewer
[Unit]
Description=JARVIS intraday viewer
After=network-online.target

[Service]
User=jarvis
WorkingDirectory=/home/jarvis/JARVIS
EnvironmentFile=/home/jarvis/JARVIS/.env
ExecStart=/home/jarvis/JARVIS/.venv/bin/python -m webapp --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5
# the viewer must never starve the collector: cap its memory (SCRUM-216, 22 Nov 2026).  The viewer process itself stays small (about 0.4 GB: the Signals tab
# reads slices of a day reduced on disk by webapp/reduced.py, and the heavy whole-day calls run in a child process that exits).  A child is killed above
# JARVIS_VIEWER_CHILD_MB; it shares this cgroup, so 0.4 GB + 1.4 GB stays under MemoryMax.  No MemoryHigh: on 18 Nov it throttled the viewer so hard that
# /api/perf timed out.  The in-process fallback (JARVIS_VIEWER_REDUCED=0) stops reading a day at JARVIS_VIEWER_MEM_GUARD_MB.  The box has 16 GB; the
# feeds and engines use 3-5.
MemoryMax=2G
Environment=MALLOC_ARENA_MAX=2
Environment=JARVIS_VIEWER_CHILD_MB=1400
Environment=JARVIS_VIEWER_MEM_GUARD_MB=1200
Environment=JARVIS_VIEWER_ANSWER_CACHE_MB=60
# Jobs started from the Jobs tab (JARVIS_JOB_CONTROL=1, SCRUM-204) are children of the viewer: a restart of the viewer must not kill
# them.  They still count against MemoryMax above, so a heavy job (the end-of-day compaction needs several GB) is better run from cron.
KillMode=process

[Install]
WantedBy=multi-user.target
