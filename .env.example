# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Financial Modeling Prep API key
# Get yours at: https://financialmodelingprep.com/developer/docs
FMP_API_KEY=your_fmp_api_key_here

# Rate limiting (seconds between API calls)
# Free tier  (~250 req/day)    : 0.5
# Starter tier (~300 req/min)  : 0.2
FMP_RATE_LIMIT_DELAY=0.5

# Upstox API v3 market-data feed (India live ticks / L1).
# Create an app at the Upstox developer console (New App) to get these three.
UPSTOX_API_KEY=your_api_key
UPSTOX_API_SECRET=your_api_secret
UPSTOX_REDIRECT_URI=http://localhost:8000
# Written by `python -m data_layer.upstox.auth exchange ...` (do not edit by hand).
# The access token EXPIRES DAILY; refresh it before the NSE session (03:40 UTC).
UPSTOX_ACCESS_TOKEN=
UPSTOX_EXTENDED_TOKEN=
# Optional, to avoid the daily login: generate once a year at the developer console
# (Developer Apps -> your app -> Analytics tab -> Generate Token) and paste it in here by hand.
# Upstox docs say 1-year validity, read-only, and list "Websocket" as a supported category --
# run `python -m data_layer.upstox.auth check` to confirm it works against this feed.
UPSTOX_ANALYTICS_TOKEN=
# Written by `python -m data_layer.upstox.auth check --adopt` if a long-lived token is accepted.
UPSTOX_FEED_TOKEN=

# Where nightly backups go: a DIFFERENT disk or mounted bucket than the data (python -m data_layer.backup)
JARVIS_BACKUP_DIR=/mnt/backup/jarvis

# Intraday viewer login (set both to require HTTP Basic auth; use TLS in front of it)
WEBAPP_USER=
WEBAPP_PASSWORD=
# JARVIS admin at /admin (data browser, read-only SQL, subscription list). Off unless both are set; separate from
# the viewer login above and from the TensorT Labs admin console. Use a long password; serve over HTTPS only.
ADMIN_USER=
ADMIN_PASSWORD=

# What the live feed stores (read at feed start; see data_layer/tick_policy.py). Default is everything.
#   full     every tick                                   (option C)
#   throttle at most one tick per symbol per interval     (option B)
#   changes  only when price/volume/quote/OI change       (option A)
JARVIS_TICK_STORE=full
# JARVIS_TICK_STORE_FO=full        # per segment, wins over the line above (also _EQ)
# JARVIS_TICK_MIN_INTERVAL_S=1     # for throttle
JARVIS_GREEKS=all                  # all | iv | none
# JARVIS_GREEKS_DECIMALS=4         # round Greeks (smaller files); empty = no rounding

# Live five-level book (memory only, never stored): local ports the feed collectors serve and the viewer reads. 0 = off.
# JARVIS_BOOK_PORT_EQ=8771
# JARVIS_BOOK_PORT_FO=8772

# Upstox probe (python -m data_layer.upstox.probe): where it keeps what it collects, never the production lake
# JARVIS_PROBE_DIR=probe_data
# Store trade size, average price, book totals, previous close, auction fields and session events in the live feed.
# Off until the probe has measured the cost (SCRUM-100).
# JARVIS_EXT_FIELDS=1
